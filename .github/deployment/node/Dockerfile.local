# syntax=docker/dockerfile:1.7
# Local variant of .github/deployment/node/Dockerfile.
#
# The upstream Dockerfile expects CI to have relocated the production
# node_modules into packages/backend/server (`yarn workspaces focus
# @affine/server --production && mv ./node_modules ./packages/backend/server`).
# On Windows that mv trips over file locks, so this variant copies the
# already-pruned root node_modules straight to /app/node_modules instead.
FROM node:22-bookworm-slim
WORKDIR /app

COPY packages/backend/server /app
COPY node_modules /app/node_modules
COPY packages/frontend/apps/web/dist /app/static
COPY packages/frontend/admin/dist /app/static/admin
COPY packages/frontend/apps/mobile/dist /app/static/mobile

RUN apt-get update && \
  apt-get install -y --no-install-recommends openssl libjemalloc2 && \
  rm -rf /var/lib/apt/lists/*

# Enable jemalloc by preloading the library
ENV LD_PRELOAD=libjemalloc.so.2

EXPOSE 3010

CMD ["sh", "-c", "node ./scripts/upgrade-config.js && exec node ./dist/main.js"]
